[Unit]
Description=GMK67 Keyboard Time Sync Daemon
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gmk67sts --daemon
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gmk67sts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target